<Project>

  <!-- Shared settings for every project in the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Authors>Timothy van der Ham</Authors>
    <Company>Timothy van der Ham</Company>
    <Product>VellumPdf</Product>
    <Copyright>Copyright © Timothy van der Ham (@Tim81)</Copyright>
    <VersionPrefix>2.3.2</VersionPrefix>

    <!--
      Pinned to the major version, not tracked from VersionPrefix. Now that the assemblies are
      strong-named (#53), AssemblyVersion is part of their identity: leaving it to follow the
      package version would make 2.0.1 a different identity from 2.0.0, re-inflicting on a patch
      release exactly the rebinding this major release asks consumers to absorb once. Pinning it
      keeps the whole 2.x line one identity; AssemblyFileVersion and AssemblyInformationalVersion
      still carry the precise version, so the build is still identifiable.
      Bump this only for 3.0.
    -->
    <AssemblyVersion>2.0.0.0</AssemblyVersion>

    <!--
      Verify 33+ fails the build (SC021) unless one SponsorCheck property is set. The official
      NuGet binaries after 2026-09-01 carry an Open Source Maintenance Fee for revenue-generating
      organisations; the source stays Apache-2.0. This repository is an open-source project that
      does not generate revenue, so the OpenSource exemption applies. It is time-bounded: renew
      the month before it lapses, at most 12 months from the build date.
    -->
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-08</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>

</Project>
