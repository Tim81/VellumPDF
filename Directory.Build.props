<Project>

  <!-- Shared settings for every project in the repository. -->
  <PropertyGroup>
    <!--
      Both supported runtimes, built from one SDK. net10.0 is the LTS and net11.0 the STS release
      (both end of support 2028-11-14). Replacing TargetFramework, rather than adding beside it, is
      what makes this multi-target: a non-empty TargetFramework wins over TargetFrameworks even
      when both are set in this one file, and a probe of a project that sets TargetFramework under
      a props file that sets TargetFrameworks restored both frameworks but built one.
    -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!--
      Pinned, not "latest". "latest" follows the SDK: on SDK 11.0.100 it compiled both frameworks as
      C# 15 (measured with a #error version probe), where SDK 10.0.404 gave 14.0. Features such as
      extension indexers need no new runtime type, so they would compile for net10.0 as well and hand
      net10.0 consumers on SDK 10 a surface built for C# 15. The language version moves by an
      explicit, reviewed change, not with the SDK band.
    -->
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Authors>Timothy van der Ham</Authors>
    <Company>Timothy van der Ham</Company>
    <Product>VellumPdf</Product>
    <Copyright>Copyright © Timothy van der Ham (@Tim81)</Copyright>
    <VersionPrefix>2.3.3</VersionPrefix>

    <!--
      Pinned to the major version, not tracked from VersionPrefix. Now that the assemblies are
      strong-named (#53), AssemblyVersion is part of their identity: leaving it to follow the
      package version would make 2.0.1 a different identity from 2.0.0, re-inflicting on a patch
      release exactly the rebinding this major release asks consumers to absorb once. Pinning it
      keeps the whole 2.x line one identity; AssemblyFileVersion and AssemblyInformationalVersion
      still carry the precise version, so the build is still identifiable.
      Bump this only for 3.0.
    -->
    <AssemblyVersion>2.0.0.0</AssemblyVersion>

    <!--
      Verify 33+ fails the build (SC021) unless one SponsorCheck property is set. The official
      NuGet binaries after 2026-09-01 carry an Open Source Maintenance Fee for revenue-generating
      organisations; the source stays Apache-2.0. This repository is an open-source project that
      does not generate revenue, so the OpenSource exemption applies. It is time-bounded: renew
      the month before it lapses, at most 12 months from the build date.
    -->
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-08</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>

</Project>
