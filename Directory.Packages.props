<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Test and tooling packages only.
    Runtime library projects (src/**) take ZERO third-party dependencies by design.
    Exception: VellumPdf.Signing is an optional add-on that carries the Pkcs NuGet dep.
  -->
  <ItemGroup>
    <!--
      Kept in the same major band as the target framework. It was pinned at 9.0.5 on a net10.0-only
      library, so the one third-party runtime dependency this repository ships — and it ships on the
      signing package — was a servicing-stale .NET 9 build.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.11" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!-- xunit.v3 4.0.0 ships xunit.v3.core.mtp-v2 / xunit.v3.mtp-v2, which pull in
         Microsoft.Testing.Platform; the .NET 10 SDK refuses the VSTest target these tests used to
         run under, so Microsoft.NET.Test.Sdk and xunit.runner.visualstudio (both VSTest-only) are
         gone rather than bumped (#200). -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <!-- VellumPdf.TestSupport needs only Assert (Assert.Skip/Assert.Fail), not the full v3
         runner the "xunit.v3" meta-package pulls in — that package requires an executable
         test host (OutputType=Exe), which a shared helper library is not. -->
    <PackageVersion Include="xunit.v3.assert" Version="4.0.0" />
    <PackageVersion Include="Verify.XunitV3" Version="32.0.0" />
    <PackageVersion Include="CsCheck" Version="4.8.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- coverlet's native Microsoft.Testing.Platform extension, replacing the VSTest-only
         coverlet.collector (#200). Chosen over Microsoft.Testing.Extensions.CodeCoverage on
         licence grounds: MIT with no acceptance requirement, where the Microsoft package declares
         no SPDX expression and sets requireLicenseAcceptance. -->
    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
  </ItemGroup>

</Project>
