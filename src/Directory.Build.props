<Project>

  <!-- Inherit the repository-wide settings (MSBuild only auto-imports the nearest file). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Settings specific to shippable library projects. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- A genuine selling point: no native binaries, AOT- and trim-ready, single managed DLL. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>

    <!-- Packaging -->
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/Tim81/VellumPDF/blob/main/CHANGELOG.md for release notes.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/Tim81/VellumPDF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Tim81/VellumPDF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Strong-named for assembly identity (#53). The private key is committed
         intentionally: it is an identity mechanism, not a security boundary
         for OSS, and the project does not delay-sign. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)../eng/VellumPdf.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!--
    Public-API surface lock. The PublicApiAnalyzers compare the live public surface
    against the committed PublicAPI.{Shipped,Unshipped}.txt baselines so that any
    accidental addition/removal/rename of public API is a build error. This is the
    guardrail for the 1.0 API contract (issue #3).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Shipped.txt" Condition="Exists('$(MSBuildProjectDirectory)\PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Unshipped.txt" Condition="Exists('$(MSBuildProjectDirectory)\PublicAPI.Unshipped.txt')" />
  </ItemGroup>

  <!--
    Platform line ends (#630). Some framework calls write the platform line end, CR LF on
    Windows and LF elsewhere, so a library that uses them for bytes it puts in a PDF writes
    different files on different operating systems. CI runs the tests on Linux only, where
    those calls write LF, so a test cannot catch a regression; the build can. src/BannedSymbols.txt
    refuses StringBuilder.AppendLine, Environment.NewLine, TextWriter.WriteLine and
    TextWriter.NewLine, Console.WriteLine, the parameterless String.ReplaceLineEndings,
    File.WriteAllLines and File.AppendAllLines, XNode.ToString, the XDocument and XElement Save
    overloads other than the XmlWriter ones, and the XmlDocument.Save overloads other than the
    XmlWriter one, each with every overload. A literal CR LF in a string, a writer whose settings
    indent with the platform line end (XmlWriterSettings.Indent without NewLineChars), and any
    call not on that list are not caught. VellumPdf.Cli is exempt because it writes no PDF bytes:
    it prints to a console and writes report files when given an output path.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'VellumPdf.Cli'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

</Project>
