<Project>

  <!--
    Per-package NuGet README.

    Each shippable project may ship its own README.md next to the .csproj; a package
    without one falls back to the shared repository-root README. The property that names
    the README slot lives in Directory.Build.props (PackageReadmeFile); the packing lives
    here in .targets rather than .props on purpose: the SDK's default-item glob already
    includes a project-local README.md as a None item, and that glob is evaluated after
    Directory.Build.props but before Directory.Build.targets. Updating the existing item
    (rather than Include-ing a second one) avoids a duplicate-item error; the root fallback
    lives outside the project directory, so it is not globbed and is added with Include.
  -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(MSBuildProjectDirectory)/README.md') And Exists('$(MSBuildThisFileDirectory)../README.md')">
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    NOTICE, in every package.

    The Adobe Glyph List and the ZapfDingbats glyph list are embedded resources of the Reader and
    Conformance packages, and BSD-3-Clause requires a redistribution in binary form to reproduce
    the copyright notice and disclaimer "in the documentation and/or other materials provided with
    the distribution". The GIF specification's section 3 grant asks for its acknowledgement in User
    and Technical Documentation from any software that uses the format, which binds the Kernel
    package, the one that actually contains a GIF decoder and encoder, not every package that
    merely depends on it. NOTICE is where both obligations live, and it is packed into every
    package regardless of which one the obligation binds: a developer restoring any one package
    finds the acknowledgement beside the package they actually reference, and one rule that packs
    it everywhere beats a per-package list that has to be kept in step with which package happens
    to implement a given format. Until this it was packed into no package at all:
    PackageLicenseExpression emits an SPDX identifier rather than a file, and the README rule
    above packs one README, never NOTICE.
    It sits outside the project directory so the SDK's default glob does not reach it, hence
    Include rather than Update.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../NOTICE')">
    <None Include="$(MSBuildThisFileDirectory)../NOTICE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
