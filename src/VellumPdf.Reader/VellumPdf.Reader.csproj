<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VellumPdf.Kernel\VellumPdf.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Adobe Glyph List (BSD-3-Clause; see NOTICE). Byte-identical to the Conformance package's
         own copy; embedded for the glyph-name-to-Unicode route of ISO 32000-2 §9.10.2. -->
    <EmbeddedResource Include="Resources\AdobeGlyphList.txt">
      <LogicalName>AdobeGlyphList.txt</LogicalName>
    </EmbeddedResource>
    <!-- ZapfDingbats glyph list (BSD-3-Clause; see NOTICE), normalised from the Adobe AGL
         repository's own zapfdingbats.txt. -->
    <EmbeddedResource Include="Resources\ZapfDingbatsGlyphList.txt">
      <LogicalName>ZapfDingbatsGlyphList.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <RootNamespace>VellumPdf.Reader</RootNamespace>
    <AssemblyName>VellumPdf.Reader</AssemblyName>
    <PackageId>VellumPdf.Reader</PackageId>
    <Description>PDF reader for VellumPdf: opens an existing PDF (classic cross-reference tables, cross-reference and object streams, hybrid-reference files, and encrypted documents given their password) and exposes its catalog and digital signatures, on a bounds-checked lexer and object parser (ISO 32000-2 §7.2–7.5). BCL-only; zero runtime dependencies. The foundation for PAdES long-term validation and a growing general reader; content extraction is not supported yet.</Description>
    <PackageTags>pdf;reader;parser;aot</PackageTags>
  </PropertyGroup>

</Project>
