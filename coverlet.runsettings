<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- VellumPdf.TestSupport is test infrastructure (the OracleGate, fixture helpers) that
               ships under tests/, not one of the eight shipping packages, so it belongs in the
               same exclusion as the *.Tests assemblies themselves (#229): instrumenting it only
               pads the denominator with near-100%-covered helper code and hides the shipping
               assemblies' real rate behind it. -->
          <Exclude>[*.Tests]*,[VellumPdf.TestSupport]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
