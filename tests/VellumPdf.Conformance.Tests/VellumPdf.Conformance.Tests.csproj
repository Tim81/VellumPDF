<Project Sdk="Microsoft.NET.Sdk">

  <!-- InternalsVisibleTo friend of Kernel, Reader and Conformance (#53) — must match their public key. -->
  <Import Project="$(MSBuildThisFileDirectory)../../eng/StrongNameTestFriend.props" />

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../eng/StrongNamePublicKeyAssertion.cs" Link="StrongNamePublicKeyAssertion.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VellumPdf.Kernel\VellumPdf.Kernel.csproj" />
    <ProjectReference Include="..\..\src\VellumPdf.Reader\VellumPdf.Reader.csproj" />
    <ProjectReference Include="..\..\src\VellumPdf.Conformance\VellumPdf.Conformance.csproj" />
    <ProjectReference Include="..\..\src\VellumPdf.Fonts.Standard14\VellumPdf.Fonts.Standard14.csproj" />
    <ProjectReference Include="..\..\src\VellumPdf.Signing\VellumPdf.Signing.csproj" />
    <ProjectReference Include="..\VellumPdf.TestSupport\VellumPdf.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>

  <ItemGroup>
    <!-- DejaVu Sans (permissive Bitstream Vera / public-domain license; see Assets/DejaVuSans-LICENSE.txt).
         Embedded so the oracle's embedded-font fixture is portable and hermetic — no system font path. -->
    <EmbeddedResource Include="Assets\DejaVuSans.ttf">
      <LogicalName>DejaVuSans.ttf</LogicalName>
    </EmbeddedResource>
    <!-- SourceSans3-ExtraLight (SIL OFL 1.1; see Assets/SourceSans3-LICENSE.md).
         OpenType/CFF font used for the §6.2.11.2-7 FontFile3 /Subtype fixtures. -->
    <EmbeddedResource Include="Assets\SourceSans3-ExtraLight.otf">
      <LogicalName>SourceSans3-ExtraLight.otf</LogicalName>
    </EmbeddedResource>
    <!-- Noto Sans Shavian (SIL OFL 1.1; see Assets/NotoSansShavian-LICENSE.txt).
         A real classic Type 1 (PFB) program — the only font flavour that embeds via /FontFile —
         used for the §6.2.11.4.2-1 Type1 /CharSet completeness fixtures. -->
    <EmbeddedResource Include="Assets\NotoSansShavian-Regular.pfb">
      <LogicalName>NotoSansShavian-Regular.pfb</LogicalName>
    </EmbeddedResource>
    <!-- Generated once with qpdf (empty user password, owner "o", AES-128) from the exact bytes
         PdfPreflightTests.BuildJpxImagePdf(BuildJp2(nc: 2, bpc: 8).File) produces, then committed —
         see Jpeg2000Rule's #97 encrypted-document test for why: the JPXDecode image XObject rule
         reads DecryptedRawBody, not stream.RawBody, and needs a real encrypted fixture to pin that. -->
    <EmbeddedResource Include="Assets\jpx-encrypted-emptyuser.pdf">
      <LogicalName>jpx-encrypted-emptyuser.pdf</LogicalName>
    </EmbeddedResource>
    <!-- Built once by this library's own writer with the /P bit 10 accessibility bit deliberately
         cleared, then committed — see Assets/README.md for exactly how, and why #397 will remove
         the writer's ability to reproduce it. Used by UaEncryptionPermissionsRuleTests. -->
    <EmbeddedResource Include="Assets\enc-aes-256-p-bit10-clear.pdf">
      <LogicalName>enc-aes-256-p-bit10-clear.pdf</LogicalName>
    </EmbeddedResource>
    <!-- A byte-identical copy of VellumPdf.Reader.Tests/Fixtures/Encrypted/enc-aes-128.pdf (this
         project does not reference VellumPdf.Reader.Tests, so fixtures it needs are copied rather
         than shared). AESv2, user password "u", owner "o", /P -4 — the real-user-password fixture
         PdfPreflightPasswordOverloadTests exercises the four new password overloads against. -->
    <EmbeddedResource Include="Assets\enc-aes-128-userpw-u.pdf">
      <LogicalName>enc-aes-128-userpw-u.pdf</LogicalName>
    </EmbeddedResource>
    <!-- Built once by this library's writer (empty user password, owner "vellum-test-owner",
         Permissions = All) and committed rather than built in-test, then confirmed against a local
         veraPDF 1.30.2 run before being checked in — see Assets/README.md and
         UaEncryptionPermissionsVeraPdfTests.cs for why. Used by
         CompliantFixture_veraPdfReportsNoClause716Element. -->
    <EmbeddedResource Include="Assets\enc-aes-256-emptyuser-p-all.pdf">
      <LogicalName>enc-aes-256-emptyuser-p-all.pdf</LogicalName>
    </EmbeddedResource>
    <!-- Built once by this library's writer (user password "u", Permissions = All) and committed
         for the same reason as enc-aes-256-emptyuser-p-all.pdf above — see Assets/README.md. Used
         by UserPasswordDocument_noPassword_refusalMatchesInProcessThrow and
         UserPasswordDocument_withPassword_verdictMatchesVeraPdf. -->
    <EmbeddedResource Include="Assets\enc-aes-256-userpw-u-p-all.pdf">
      <LogicalName>enc-aes-256-userpw-u-p-all.pdf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
