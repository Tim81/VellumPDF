<Project Sdk="Microsoft.NET.Sdk">

  <!-- InternalsVisibleTo friend of Reader and Signing (#53) — must match their public key. -->
  <Import Project="$(MSBuildThisFileDirectory)../../eng/StrongNameTestFriend.props" />

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../eng/StrongNamePublicKeyAssertion.cs" Link="StrongNamePublicKeyAssertion.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VellumPdf.Kernel\VellumPdf.Kernel.csproj" />
    <ProjectReference Include="..\..\src\VellumPdf.Reader\VellumPdf.Reader.csproj" />
    <ProjectReference Include="..\..\src\VellumPdf.Signing\VellumPdf.Signing.csproj" />
    <ProjectReference Include="..\VellumPdf.TestSupport\VellumPdf.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Encrypted reader fixtures (#99), one per standard-security-handler V/R combination, plus the
         plaintext baseline they all decrypt back to. Generated once with qpdf and committed rather than
         shelled out for at test time: CI runs qpdf 11.9.0 and local development 12.3.2, so committing
         them keeps the corpus byte-identical everywhere and leaves no OracleGate skip hole. Embedded so
         the corpus is hermetic, matching how VellumPdf.Conformance.Tests carries its font assets.
         See Fixtures/Encrypted/README.md for the exact generating commands. -->
    <EmbeddedResource Include="Fixtures\Encrypted\*.pdf">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Third-party reader fixtures (#196): PDFs not produced by VellumPdf's own writer, so the
         reader gets exercised against another producer's dialect instead of only its own. Sourced
         from qpdf and poppler where a tool can produce the shape, hand-built where none can (qpdf
         normalizes generations to 0 on write and cannot create a hybrid-reference or
         /Length-mismatched file). Committed rather than generated at test time, for the same reason
         as Fixtures/Encrypted (#99); see Fixtures/ThirdParty/README.md for provenance and exact
         commands. The logical name is folder-qualified so its resources stay distinguishable, in
         the shared assembly manifest, from the flat-named Fixtures/Encrypted set. -->
    <EmbeddedResource Include="Fixtures\ThirdParty\*.pdf">
      <LogicalName>ThirdParty/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
