<Project Sdk="Microsoft.NET.Sdk">

  <!-- InternalsVisibleTo friend of Kernel and Reader (#53) — must match their public key. -->
  <Import Project="$(MSBuildThisFileDirectory)../../eng/StrongNameTestFriend.props" />

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../eng/StrongNamePublicKeyAssertion.cs" Link="StrongNamePublicKeyAssertion.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VellumPdf.Kernel\VellumPdf.Kernel.csproj" />
    <ProjectReference Include="..\..\src\VellumPdf.Layout\VellumPdf.Layout.csproj" />
    <ProjectReference Include="..\..\src\VellumPdf.Reader\VellumPdf.Reader.csproj" />
    <ProjectReference Include="..\..\src\VellumPdf.Signing\VellumPdf.Signing.csproj" />
    <ProjectReference Include="..\..\src\VellumPdf.Fonts.Standard14\VellumPdf.Fonts.Standard14.csproj" />
    <ProjectReference Include="..\VellumPdf.TestSupport\VellumPdf.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <!-- In-tree fonts, copied beside the test assembly so embedded-font tests need no system font
       directory. DejaVu Sans has the no-break-space glyphs; the two Liberation Sans faces are two
       different fonts. -->
  <ItemGroup>
    <None Include="..\VellumPdf.Conformance.Tests\Assets\DejaVuSans.ttf" Link="Fonts\DejaVuSans.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\VellumPdf.Fonts.Standard14\Fonts\LiberationSans-Regular.ttf" Link="Fonts\LiberationSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\VellumPdf.Fonts.Standard14\Fonts\LiberationSans-Bold.ttf" Link="Fonts\LiberationSans-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\VellumPdf.Fonts.Standard14\Fonts\LiberationMono-Regular.ttf" Link="Fonts\LiberationMono-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\VellumPdf.Conformance.Tests\Assets\SourceSans3-ExtraLight.otf" Link="Fonts\SourceSans3-ExtraLight.otf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
