<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared helpers for the external-oracle tests (#198): this is a library the four oracle test
    projects reference, not a test project of its own, so it overrides the runner bits that
    tests/Directory.Build.props sets for everything under this directory.
  -->
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!--
    tests/Directory.Build.props adds "xunit.v3" (the full runner meta-package), which assumes an
    executable test project — this library is not one ("xunit.v3" pulls in xunit.v3.core.mtp-v2,
    whose own buildTransitive targets enforce OutputType=Exe via a build-time check). OracleGate
    only needs Assert.Skip/Assert.Fail, so swap the meta-package for the assertion library alone.
  -->
  <ItemGroup>
    <PackageReference Remove="xunit.v3" />
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>

</Project>
