<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Manual Native AOT validation harness (not a unit-test project).
    Lives under eng/ so the tests/Directory.Build.props (xUnit) does not apply
    and the clean-room scan excludes it. Not part of VellumPdf.slnx; published
    directly by path:  dotnet publish eng/aot/VellumPdf.AotSmoke -c Release -r <rid> -f <tfm>
    (a multi-targeted Exe needs -f, or the publish fails with NETSDK1129; run-aot-smoke.ps1 does both TFMs)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\VellumPdf.Layout\VellumPdf.Layout.csproj" />
    <ProjectReference Include="..\..\..\src\VellumPdf.Signing\VellumPdf.Signing.csproj" />
    <ProjectReference Include="..\..\..\src\VellumPdf.Reader\VellumPdf.Reader.csproj" />
    <ProjectReference Include="..\..\..\src\VellumPdf.Conformance\VellumPdf.Conformance.csproj" />
    <ProjectReference Include="..\..\..\src\VellumPdf.Barcodes\VellumPdf.Barcodes.csproj" />
    <ProjectReference Include="..\..\..\src\VellumPdf.Fonts.Standard14\VellumPdf.Fonts.Standard14.csproj" />
  </ItemGroup>

</Project>
